\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  \textbf  {Sensitivity to steering coefficient $\alpha $ on MMMB.} Performance peaks at $\alpha {=}0.2$ and degrades sharply beyond $\alpha {=}0.3$. The effective window ($\alpha \in [0.05, 0.2]$) is consistent with prior representation-engineering results \citep  {zou-etal-2023-representation}. }}{7}{figure.caption.27}\protected@file@percent }
\newlabel{fig:alpha}{{5}{7}{\textbf {Sensitivity to steering coefficient $\alpha $ on MMMB.} Performance peaks at $\alpha {=}0.2$ and degrades sharply beyond $\alpha {=}0.3$. The effective window ($\alpha \in [0.05, 0.2]$) is consistent with prior representation-engineering results \citep {zou-etal-2023-representation}}{figure.caption.27}{}}
