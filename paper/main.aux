\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  \textbf  {Qualitative logit-lens walkthrough.} Two examples where the English pivot is most severe (Portuguese, left; German, right), shown without steering (top) and with steering at $\alpha {=}0.2$ (bottom). Red arrow: layer where target-language PMI first exceeds English PMI. Inset: COCO image. Steering shifts the crossover to an earlier layer, consistent with target-language representations being amplified at the pivot layers. }}{8}{figure.caption.28}\protected@file@percent }
\newlabel{fig:qualitative}{{6}{8}{\textbf {Qualitative logit-lens walkthrough.} Two examples where the English pivot is most severe (Portuguese, left; German, right), shown without steering (top) and with steering at $\alpha {=}0.2$ (bottom). Red arrow: layer where target-language PMI first exceeds English PMI. Inset: COCO image. Steering shifts the crossover to an earlier layer, consistent with target-language representations being amplified at the pivot layers}{figure.caption.28}{}}
