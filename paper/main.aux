\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  \textbf  {Full vs.\ visual-token-only residual patch AIE.} The visual-token curve (green, dashed) is identically zero at every layer: the English pivot is mediated entirely through text-token positions. }}{5}{figure.caption.15}\protected@file@percent }
