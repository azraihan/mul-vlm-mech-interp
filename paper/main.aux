\citation{zou-etal-2023-representation}
\citation{zou-etal-2023-representation}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  \textbf  {Average Indirect Effect (AIE) heatmap.} Rows: Portuguese, German, Russian. Columns: residual stream / attention output / MLP output. The residual-stream pivot at layers 5--17 is pronounced across all languages; attention and MLP patches carry negligible weight. Yellow dashed box: shared pivot region (layers 5--17) used for steering. Green dashed box: language-specific pivot region inferred from each language's AIE profile, shown to highlight the per-language variation (e.g.\ Portuguese tapers off around layer~14 while Russian extends to~17). }}{5}{figure.caption.14}\protected@file@percent }
\newlabel{fig:patching_heatmap}{{2}{5}{\textbf {Average Indirect Effect (AIE) heatmap.} Rows: Portuguese, German, Russian. Columns: residual stream / attention output / MLP output. The residual-stream pivot at layers 5--17 is pronounced across all languages; attention and MLP patches carry negligible weight. Yellow dashed box: shared pivot region (layers 5--17) used for steering. Green dashed box: language-specific pivot region inferred from each language's AIE profile, shown to highlight the per-language variation (e.g.\ Portuguese tapers off around layer~14 while Russian extends to~17)}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  \textbf  {Design validation: visual-token-only AIE is identically zero.} The same image appears in both passes, so the 576 CLIP patch activations are identical by construction and contribute zero differential signal. This confirms correct implementation: all measurable pivot signal under this design runs through text-token positions. }}{5}{figure.caption.15}\protected@file@percent }
\newlabel{fig:visual}{{3}{5}{\textbf {Design validation: visual-token-only AIE is identically zero.} The same image appears in both passes, so the 576 CLIP patch activations are identical by construction and contribute zero differential signal. This confirms correct implementation: all measurable pivot signal under this design runs through text-token positions}{figure.caption.15}{}}
